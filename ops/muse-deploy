#!/bin/bash
set -euo pipefail

BASE=/srv/docker/muse
COMPOSE="$BASE/docker-compose.yml"
ENV_FILE="$BASE/.env"
BACKUPS="$BASE/backups"
STATE="$BASE/.deploy-state"
CURRENT="$STATE/current-image"
PREVIOUS="$STATE/previous-image"
LAST_BACKUP="$STATE/last-backup"
SERVICES=(muse-orchestrator muse-edge muse-01 muse-02 muse-03 muse-04 muse-05)

compose() {
  docker compose --env-file "$ENV_FILE" -f "$COMPOSE" "$@"
}

validate_image() {
  [[ "$1" =~ ^ghcr\.io/haxurus/muse@sha256:[a-f0-9]{64}$ ]] || {
    echo "Refusing non-immutable or unexpected image reference." >&2
    exit 64
  }
}

set_env_key() {
  local key="$1" value="$2" tmp
  tmp="$(mktemp "$BASE/.env.tmp.XXXXXX")"
  awk -v key="$key" -v value="$value" '
    BEGIN {found=0}
    index($0, key "=") == 1 {print key "=" value; found=1; next}
    {print}
    END {if (!found) print key "=" value}
  ' "$ENV_FILE" > "$tmp"
  chmod 600 "$tmp"
  chown root:root "$tmp"
  mv "$tmp" "$ENV_FILE"
}

wait_healthy() {
  local deadline=$((SECONDS + 240)) service cid status all_healthy

  while (( SECONDS < deadline )); do
    all_healthy=true

    for service in "${SERVICES[@]}"; do
      cid="$(compose ps -q "$service" || true)"
      if [[ -z "$cid" ]]; then
        all_healthy=false
        continue
      fi

      status="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$cid" 2>/dev/null || true)"
      case "$status" in
        healthy)
          ;;
        exited|dead|unhealthy)
          echo "$service entered state $status." >&2
          return 1
          ;;
        *)
          all_healthy=false
          ;;
      esac
    done

    [[ "$all_healthy" == true ]] && return 0
    sleep 3
  done

  return 1
}

stop_for_backup() {
  compose stop -t 30 "${SERVICES[@]}" >/dev/null 2>&1 || true
}

backup_db() {
  mkdir -p "$BACKUPS" "$STATE"
  chmod 700 "$BACKUPS" "$STATE"

  local stamp backup
  local -a db_files=()
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  backup="$BACKUPS/muse-fleet-$stamp.tar.gz"

  mapfile -d '' db_files < <(
    cd "$BASE"
    find control data -type f \
      \( -name 'db.sqlite' -o -name 'db.sqlite-wal' -o -name 'db.sqlite-shm' \) \
      -print0 2>/dev/null || true
  )

  if (( ${#db_files[@]} > 0 )); then
    printf '%s\0' "${db_files[@]}" | tar -C "$BASE" --null -T - -czf "$backup"
    chmod 600 "$backup"
    printf '%s\n' "$backup" > "$LAST_BACKUP"
    find "$BACKUPS" -type f -name 'muse-fleet-*.tar.gz' -mtime +14 -delete
    echo "Fleet database backup: $backup"
  else
    : > "$LAST_BACKUP"
    echo "No existing databases to back up."
  fi
}

restore_backup() {
  [[ -s "$LAST_BACKUP" ]] || return 0

  local backup
  backup="$(cat "$LAST_BACKUP")"
  [[ -f "$backup" ]] || return 0

  find "$BASE/control" "$BASE/data" -type f \
    \( -name 'db.sqlite' -o -name 'db.sqlite-wal' -o -name 'db.sqlite-shm' \) \
    -delete

  tar -C "$BASE" -xzf "$backup"
  chown -R 1000:1000 "$BASE/control" "$BASE/data"
}

deploy_image() {
  local image="$1" old=""
  validate_image "$image"

  mkdir -p "$STATE"
  chmod 700 "$STATE"

  if [[ -s "$CURRENT" ]]; then
    old="$(cat "$CURRENT")"
  else
    old="$(awk -F= '$1=="MUSE_IMAGE"{print substr($0,index($0,"=")+1)}' "$ENV_FILE" | tail -n1)"
  fi

  if [[ ! "$old" =~ ^ghcr\.io/haxurus/muse@sha256:[a-f0-9]{64}$ ]]; then
    old=""
  fi

  docker pull "$image"
  stop_for_backup
  backup_db

  if [[ -n "$old" && "$old" != "$image" ]]; then
    printf '%s\n' "$old" > "$PREVIOUS"
  fi

  set_env_key MUSE_IMAGE "$image"
  compose up -d --remove-orphans

  if wait_healthy; then
    printf '%s\n' "$image" > "$CURRENT"
    chmod 600 "$CURRENT" "$PREVIOUS" 2>/dev/null || true
    echo "Muse fleet deployed successfully."
    return 0
  fi

  echo "New fleet release failed health checks." >&2
  compose ps >&2 || true
  compose logs --tail=120 "${SERVICES[@]}" >&2 || true
  compose stop -t 15 "${SERVICES[@]}" >/dev/null 2>&1 || true

  if [[ -n "$old" ]]; then
    echo "Restoring previous application fleet and databases." >&2
    restore_backup
    set_env_key MUSE_IMAGE "$old"
    compose up -d --remove-orphans

    wait_healthy || {
      compose ps >&2 || true
      echo "Automatic rollback also failed." >&2
      exit 1
    }

    printf '%s\n' "$old" > "$CURRENT"
  fi

  exit 1
}

rollback() {
  [[ -s "$PREVIOUS" ]] || { echo "No previous image recorded." >&2; exit 1; }

  local target current
  target="$(cat "$PREVIOUS")"
  current="$(cat "$CURRENT" 2>/dev/null || true)"
  validate_image "$target"

  docker pull "$target"
  stop_for_backup
  backup_db
  set_env_key MUSE_IMAGE "$target"
  compose up -d --remove-orphans

  wait_healthy || {
    compose ps >&2 || true
    compose logs --tail=120 "${SERVICES[@]}" >&2 || true
    exit 1
  }

  printf '%s\n' "$target" > "$CURRENT"
  [[ -n "$current" ]] && printf '%s\n' "$current" > "$PREVIOUS"
  echo "Muse fleet rollback completed."
}

status() {
  compose ps
  echo
  printf 'Current:  %s\n' "$(cat "$CURRENT" 2>/dev/null || echo unknown)"
  printf 'Previous: %s\n' "$(cat "$PREVIOUS" 2>/dev/null || echo none)"
}

[[ "$(id -u)" -eq 0 ]] || { echo "Run through the restricted deploy entrypoint or as root." >&2; exit 1; }
cd "$BASE"

case "${1:-status}" in
  deploy)
    [[ $# -eq 2 ]] || { echo "Usage: muse-deploy deploy <digest>" >&2; exit 64; }
    deploy_image "$2"
    ;;
  rollback)
    [[ $# -eq 1 ]] || exit 64
    rollback
    ;;
  status)
    [[ $# -eq 1 ]] || exit 64
    status
    ;;
  *)
    exit 64
    ;;
esac
