# Direct values are convenient for local development.
DISCORD_TOKEN=
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Production can use mounted secret files instead:
# DISCORD_TOKEN_FILE=/run/secrets/discord_token
# YOUTUBE_API_KEY_FILE=/run/secrets/youtube_api_key
# SPOTIFY_CLIENT_ID_FILE=/run/secrets/spotify_client_id
# SPOTIFY_CLIENT_SECRET_FILE=/run/secrets/spotify_client_secret

DATA_DIR=./data

############
# Optional #
############

# CACHE_LIMIT=2GB
# REGISTER_COMMANDS_ON_BOT=false

# ENABLE_SPONSORBLOCK=true
# SPONSORBLOCK_TIMEOUT=5
# YT_DLP_PATH=yt-dlp
# YT_DLP_AUTO_UPDATE=false
# YT_DLP_COOKIES_PATH=/run/secrets/youtube-cookies.txt

# Generic HTTP streams are disabled by default.
# To enable them, explicitly allow trusted hostnames:
# ALLOW_HTTP_STREAMS=true
# HTTP_STREAM_ALLOWED_HOSTS=radio.example.com,stream.example.net

# BOT_STATUS=online
# BOT_ACTIVITY_TYPE=LISTENING
# BOT_ACTIVITY_URL=
# BOT_ACTIVITY=music

# MUSE_READY_FILE=/tmp/muse-ready
