MUSE_IMAGE=ghcr.io/haxurus/muse:latest
CACHE_LIMIT=1GB
REGISTER_COMMANDS_ON_BOT=false
ENABLE_SPONSORBLOCK=false
SPONSORBLOCK_TIMEOUT=5
BOT_STATUS=online
BOT_ACTIVITY_TYPE=LISTENING
BOT_ACTIVITY=music
ALLOW_HTTP_STREAMS=false
HTTP_STREAM_ALLOWED_HOSTS=

# Per-worker resource ceilings. Five workers share these values.
MUSE_WORKER_MEM_LIMIT=768m
MUSE_WORKER_CPUS=1.0
