generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model FileCache {
  hash       String   @id
  bytes      Int
  accessedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model KeyValueCache {
  key       String   @id
  value     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  guildId                             String   @id
  playlistLimit                       Int      @default(50)
  secondsToWaitAfterQueueEmpties      Int      @default(30)
  leaveIfNoListeners                  Boolean  @default(true)
  queueAddResponseEphemeral           Boolean  @default(false)
  autoAnnounceNextSong                Boolean  @default(false)
  defaultVolume                       Int      @default(100)
  defaultQueuePageSize                Int      @default(10)
  turnDownVolumeWhenPeopleSpeak       Boolean  @default(false)
  turnDownVolumeWhenPeopleSpeakTarget Int      @default(20)
  enableSponsorBlock                  Boolean  @default(false)
  createdAt                           DateTime @default(now())
  updatedAt                           DateTime @updatedAt
}

model FavoriteQuery {
  id        Int      @id @default(autoincrement())
  guildId   String
  authorId  String
  name      String
  query     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, name])
}

model ManagedGuild {
  guildId              String                    @id
  name                 String?
  configJson           String                    @default("{}")
  maxConcurrentPlayers Int                       @default(5)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  groups               BotGroup[]
  assignments          GuildWorkerAssignment[]
}

model BotGroup {
  id          String                    @id @default(cuid())
  guildId     String
  name        String
  configJson  String                    @default("{}")
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  guild       ManagedGuild              @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  assignments GuildWorkerAssignment[]

  @@unique([guildId, name])
  @@index([guildId])
}

model GuildWorkerAssignment {
  guildId        String
  workerId       String
  groupId        String?
  enabled        Boolean      @default(true)
  preferredOrder Int          @default(100)
  configJson     String       @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  guild          ManagedGuild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  group          BotGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@id([guildId, workerId])
  @@index([groupId])
}
